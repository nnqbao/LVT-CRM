# Frontend (Vite). Never commit real secrets or .env.local.
VITE_CONVEX_URL=http://127.0.0.1:3210
# Optional: site origin for HTTP auth routes (local self-hosted default is 3211)
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Self-hosted Convex CLI (local machine only; gitignored via .env.local):
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=<from local deployment admin key generation>

# Convex deployment environment variables (set via dashboard or `npx convex env set`).
# Do NOT put these in Vite or the browser:
# JWT_PRIVATE_KEY=<RS256 PKCS8 private key, single-line with spaces for newlines>
# JWKS=<public JWKS JSON string>
# SITE_URL=http://localhost:5173
# CONVEX_SITE_URL is provided by the deployment (local site proxy: http://127.0.0.1:3211)
#
# AgentMail (https://agentmail.to) for forgot-password / account-locked mail.
# Set on the Convex deployment only (never in Vite); the inbox id is its address:
# AGENTMAIL_API_KEY=<API key with send permission for the inbox>
# AGENTMAIL_INBOX_ID=thcslevantambinhthanh@agentmail.to
