# Copy to infra/convex-local/.env (untracked) and fill in THIS checkout's reservation from
# ~/ops/docs/convex-ports.md. Each LVT-CRM checkout (prod, sandbox, worktrees) has its own ports
# and project name; never commit them, and never use 3210/3211/6791 (another project's backend).
# Read by docker compose, vite.config.js, scripts/serve-production.mjs and lvt-convex-ensure.sh.
LVT_CONVEX_PROJECT=
LVT_CONVEX_BACKEND_PORT=
LVT_CONVEX_SITE_PORT=
LVT_CONVEX_DASHBOARD_PORT=
